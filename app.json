{
  "expo": {
    "name": "Z Market",
    "slug": "product-explorer",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/Z.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Z.png",
        "backgroundColor": "#F3F0FF"
      }
    },
    "web": {
      "favicon": "./assets/Z.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/Z.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA",
"dark": {
  "image": "./assets/Z.png",
  "backgroundColor": "#101114"
          }
        }
      ]
    ]
  }
}